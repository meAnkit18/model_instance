# Copy to .env for local dev, or set as Render environment variables / secrets.
# See docs/architecture.md and docs/colab-auth.md for what each of these means.

# --- Worker transport: "mock" (local dev, no Colab) or "colab" (real GPU) ---
WORKER_MODE=mock

# --- Model (model-agnostic -- swap without touching code) ---
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MODEL_REVISION=
MODEL_DTYPE=bfloat16
MAX_MODEL_LEN=4096

# --- Colab (only used when WORKER_MODE=colab) ---
COLAB_GPU=T4
COLAB_SESSION_NAME=inference-worker
COLAB_CONFIG_DIR=/data/colab-cli
COLAB_BIN=colab

# --- Lifecycle timing ---
WORKER_IDLE_TIMEOUT_SECONDS=600
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=90
STARTUP_TIMEOUT_SECONDS=900
INFERENCE_TIMEOUT_SECONDS=300
STARTUP_MAX_RETRIES=3
STARTUP_RETRY_BACKOFF_SECONDS=20

# --- Concurrency / request handling ---
MAX_CONCURRENT_REQUESTS=4
MAX_REQUEST_BODY_BYTES=1000000

# --- Security -- generate real random values for these, never commit them ---
API_KEY=
WORKER_REGISTRATION_SECRET=

# --- Mock worker (WORKER_MODE=mock only) ---
MOCK_WORKER_HOST=127.0.0.1
MOCK_WORKER_PORT=8901

# --- State persistence ---
STATE_FILE=./data/controller_state.json
