# Copy to .env for local dev, or set as Render environment variables / secrets.
# See docs/architecture.md and docs/colab-auth.md for what each of these means.

# --- Worker transport: "mock" (local dev, no Colab) or "colab" (real GPU) ---
WORKER_MODE=mock

# --- Model (model-agnostic -- swap without touching code) ---
# Hcompany/Holo1.5-3B: computer-use / GUI-agent vision-language model.
# Accepts image_url content parts (base64 data URIs) -- docs/research.md
# section 12.
MODEL_ID=Hcompany/Holo1.5-3B
MODEL_REVISION=
MODEL_DTYPE=bfloat16
MAX_MODEL_LEN=4096
# Empirically-safe cap for a T4 -- the model's own default OOMs on any
# realistic desktop screenshot (docs/research.md section 13). Raise for a
# bigger GPU (COLAB_GPU).
MAX_IMAGE_PIXELS=1003520

# --- Colab (only used when WORKER_MODE=colab) ---
COLAB_GPU=T4
COLAB_SESSION_NAME=inference-worker
# Writable dir used as $HOME for the `colab` CLI subprocess -- it resolves
# ~/.config/colab-cli/ relative to this (docs/research.md section 11).
# Leave commented out locally (defaults to your real $HOME, where
# `colab auth` already wrote its token). Set explicitly in containers --
# see Dockerfile. An empty value here would override the default with an
# empty path, so don't uncomment this without setting a real directory.
# COLAB_HOME_DIR=/data
COLAB_BIN=colab

# --- Lifecycle timing ---
WORKER_IDLE_TIMEOUT_SECONDS=600
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=90
STARTUP_TIMEOUT_SECONDS=900
INFERENCE_TIMEOUT_SECONDS=300
STARTUP_MAX_RETRIES=3
STARTUP_RETRY_BACKOFF_SECONDS=20

# --- Concurrency / request handling ---
MAX_CONCURRENT_REQUESTS=4
# A base64 screenshot easily exceeds 1MB on its own.
MAX_REQUEST_BODY_BYTES=10000000

# --- Security -- generate real random values for these, never commit them ---
API_KEY=
WORKER_REGISTRATION_SECRET=

# --- Mock worker (WORKER_MODE=mock only) ---
MOCK_WORKER_HOST=127.0.0.1
MOCK_WORKER_PORT=8901

# --- State persistence ---
STATE_FILE=./data/controller_state.json
